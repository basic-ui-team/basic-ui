{
  "name": "@basic-ui/core",
  "version": "0.4.0",
  "description": "Core components and hooks for basic-ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "dev": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "dev": "./src/components/*/index.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "generate:layout-utilities": "tsx scripts/generate-layout-utility-source.ts",
    "check:layout-utilities": "tsx scripts/generate-layout-utility-source.ts --check",
    "build": "pnpm generate:layout-utilities && vite build && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "preview": "vite preview",
    "lint": "eslint \"{src,scripts}/**/*.{ts,tsx,js,jsx}\" --cache",
    "type-check": "tsc -b tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "verify:package": "tsx scripts/verify-package/main.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@basic-ui/tokens": "workspace:*",
    "@basic-ui/icons": "workspace:*",
    "@basic-ui/react-utilities": "workspace:*",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
