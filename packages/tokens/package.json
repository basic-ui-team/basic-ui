{
  "name": "@basic-ui/tokens",
  "version": "0.4.0",
  "description": "Design tokens and theming system for basic-ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./dist/theme.css",
    "./palette-static.css": "./dist/palette-static.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-palette-static.ts",
    "build": "pnpm generate && vite build && pnpm exec tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --cache",
    "preview": "vite preview",
    "type-check": "tsc -b tsconfig.json",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "tailwindcss": "^4.2.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.1"
  }
}
